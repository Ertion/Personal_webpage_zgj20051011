{
  "name": "zgj-archive",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --var EHVIEWER_API_ORIGIN:https://zgj20051011.top",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ZGJ-archive-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ZGJ-archive-db --remote",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.127.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0"
  }
}
