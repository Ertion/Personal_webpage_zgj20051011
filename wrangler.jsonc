{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-webpage-zgj20051011",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
