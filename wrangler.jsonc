{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-webpage-zgj20051011",
  "main": "./worker.js",
  "compatibility_date": "2026-08-27",
  "secrets": {
    "required": [
      "ADMIN_PASSWORD",
      "SESSION_SECRET"
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
